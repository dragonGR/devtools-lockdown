{
  "name": "devtools-lockdown",
  "version": "1.0.0",
  "description": "Drop-in DevTools detection and page protection for production web apps",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "devtools",
    "security",
    "protection",
    "anti-devtools",
    "debugger",
    "console",
    "production",
    "lockdown",
    "inspect",
    "browser-security"
  ],
  "author": "Alex Tsanis <alex@debtman.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dragonGR/devtools-lockdown"
  },
  "homepage": "https://github.com/dragonGR/devtools-lockdown#readme",
  "bugs": {
    "url": "https://github.com/dragonGR/devtools-lockdown/issues"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  }
}
